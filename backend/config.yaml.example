database:
  type: sqlite
  host: ""
  port: 5432
  user: ""
  password: ""
  name: plannerot

security:
  jwt:
    secret_key: "CHANGE_ME_RANDOM_SECRET"
    algorithm: HS256
    access_token_expire_minutes: 60
    refresh_token_expire_days: 7

server:
  host: "0.0.0.0"
  port: 8000
  ssl_keyfile: ""
  ssl_certfile: ""
  cors_origins:
    - "http://localhost:3000"
    - "http://127.0.0.1:3000"

seed:
  excel_path: "../base_docs/demo.xlsx"
  admin_username: "admin"
  admin_password: "admin123"

rate_limit:
  login: "10/minute"